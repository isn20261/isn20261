# Copy to .env.local and fill in from your Pulumi `dev` stack outputs.
# Public on purpose — Cognito User Pool + Client IDs are not secrets;
# the Pool's password policy + JWT-protected API enforce access.

NEXT_PUBLIC_COGNITO_REGION=sa-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=

# OAuth 2.0 / Google Hosted UI (issue #181). Only needed for social login.
# Get the domain from: `pulumi stack output cognito_hosted_ui_domain`.
# Example: https://cinedica-dev.auth.sa-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# Must exactly match a callback URL registered on the User Pool Client.
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# API Gateway base URL (no trailing slash). Two modes:
#
# localhost:3000  — set to the full Gateway URL (pulumi stack output api_internal_url).
#                   The API Gateway CORS allowlist already includes http://localhost:3000.
#                   Example: https://abc123.execute-api.sa-east-1.amazonaws.com
#
# Codespace / any other origin — leave EMPTY and set API_PROXY_TARGET below instead.
#   The Next.js dev server proxies /api/v1/* server-to-server (no browser CORS).
#   In production this variable is also empty — CloudFront routes /api/v1/* to the
#   Gateway, so the browser never crosses origins.
NEXT_PUBLIC_API_BASE_URL=

# Dev-only CORS proxy target (server-side, NOT exposed to the browser).
# Set to the full API Gateway URL when NEXT_PUBLIC_API_BASE_URL is left empty.
# Never set in production builds.
# Example: https://abc123.execute-api.sa-east-1.amazonaws.com
API_PROXY_TARGET=
